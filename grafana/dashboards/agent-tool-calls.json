    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "text",
            "mode": "fixed"
          },
          "decimals": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\", tool_name=~\"$tool\", tool_success=\"false\"}[$__range] anchored)) or vector(0)) / sum(increase(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__range] anchored)))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Success rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "text",
            "mode": "fixed"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(agent_otel_kit_tool_duration_milliseconds_bucket{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__range] anchored)))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "p95 tool duration",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "interval": "1m",
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tool_name) (increase(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__interval] anchored))",
          "legendFormat": "{{tool_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tool calls per interval by tool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "interval": "1m",
      "options": {
        "legend": {
          "calcs": [
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, tool_name) (rate(agent_otel_kit_tool_duration_milliseconds_bucket{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "{{tool_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 duration by tool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Succeeded"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 13
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (agent_name, tool_name) (increase(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__range] anchored)))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent_name, tool_name) (increase(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__range] anchored)) - sum by (agent_name, tool_name) (increase(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\", tool_name=~\"$tool\", tool_success=\"false\"}[$__range] anchored) or (0 * increase(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__range] anchored)))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, agent_name, tool_name) (increase(agent_otel_kit_tool_duration_milliseconds_bucket{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__range] anchored)))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, agent_name, tool_name) (increase(agent_otel_kit_tool_duration_milliseconds_bucket{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__range] anchored)))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Per tool",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "agent_name": 0,
              "tool_name": 1
            },
            "renameByName": {
              "Value #A": "Calls",
              "Value #B": "Succeeded",
              "Value #C": "p50",
              "Value #D": "p95",
              "agent_name": "Agent",
              "tool_name": "Tool"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "agent_name",
                "tool_name"
              ]
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "tool_decision events: who allowed or rejected each tool call (config, user, hook, classifier).",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 13
      },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (tool_name, decision, source) (count_over_time({service_name=~\".+\", agent_name=~\"$agent\"} | event_name=\"tool_decision\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Permission decisions",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Value": 3,
              "decision": 1,
              "source": 2,
              "tool_name": 0
            },
            "renameByName": {
              "Value": "Count",
              "decision": "Decision",
              "source": "Source",
              "tool_name": "Tool"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value",
                "decision",
                "source",
                "tool_name"
              ]
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Error text is not collected by default; error_type is.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\".+\", agent_name=~\"$agent\"} | tool_success=\"false\" | line_format \"{{.agent_name}}  {{.tool_name}}  {{.error_type}}  {{.duration_ms}} ms  session={{.session_id}}\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Failed tool calls",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "agent-otel-kit"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values({agent_name!=\"\"}, agent_name)",
        "includeAll": true,
        "label": "Agent",
        "multi": true,
        "name": "agent",
        "query": {
          "qryType": 1,
          "query": "label_values({agent_name!=\"\"}, agent_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\"}, tool_name)",
        "includeAll": true,
        "label": "Tool",
        "multi": true,
        "name": "tool",
        "query": {
          "qryType": 1,
          "query": "label_values(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\"}, tool_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
