      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(agent_otel_kit_tool_duration_milliseconds_count{agent_name=~\"$agent\", tool_name=~\"$tool\"}[$__range] anchored))",
