          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Most expensive sessions",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Value": 3,
              "agent_name": 1,
              "model": 2,
              "session_id": 0
            },
            "renameByName": {
              "Value": "Cost (USD)",
              "agent_name": "Agent",
              "model": "Model",
              "session_id": "Session"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value",
                "agent_name",
                "model",
                "session_id"
              ]
