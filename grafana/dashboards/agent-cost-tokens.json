  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "agent-otel-kit"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values({agent_name!=\"\"}, agent_name)",
        "includeAll": true,
        "label": "Agent",
        "multi": true,
        "name": "agent",
        "query": {
          "qryType": 1,
          "query": "label_values({agent_name!=\"\"}, agent_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values({agent_name=~\"$agent\", model!=\"\"}, model)",
        "includeAll": true,
        "label": "Model",
        "multi": true,
        "name": "model",
        "query": {
          "qryType": 1,
          "query": "label_values({agent_name=~\"$agent\", model!=\"\"}, model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
