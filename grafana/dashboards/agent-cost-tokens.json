      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Value": 3,
              "agent_name": 0,
              "model": 1,
              "type": 2
            },
            "renameByName": {
              "Value": "Tokens",
              "agent_name": "Agent",
              "model": "Model",
              "type": "Type"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value",
                "agent_name",
                "model",
                "type"
              ]
            }
          }
        }
      ],
      "type": "table"
